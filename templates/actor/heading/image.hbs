<div class="pipboy-panel pipboy-portrait">
    <div class="pb-eyebrow">Profile</div>
    <div class="pb-portrait-frame">
        <img class="profile-pic" src="{{ actor.img }}" data-edit="img" data-tooltip="{{ actor.name }}" />
        {{#if actor.inCombat}}<div class="pb-badge pb-badge-combat">In Combat!</div>{{/if}}
        {{#if actor.system.saveFailures.third}}<div class="pb-badge pb-badge-dead">DECEASED</div>{{/if}}
    </div>
    <div class="current-caps pb-caps-row">
        <img data-tooltip="Bottlecaps"
             class="custom-icon pb-caps-icon"
             src="/systems/arcane-arcade-fallout/assets/caps.webp" />
        <input id="caps" type="number" name="system.caps" value="{{ caps }}" />
    </div>
    <div class="pb-carryload-row" data-inspect-carryload>
        <i class="fas fa-weight-hanging"></i>
        <span class="statusnum pb-carryload-value" data-tooltip="Current = {{system.carryLoad.base}} + {{system.carryLoad.modifiers}} / Max = {{system.carryLoad.baseMax}} + {{system.carryLoad.modifiersMax}} + {{system.carryLoad.manualMax}}">
            {{ system.carryLoad.value }} / {{system.carryLoad.max}}
        </span>
    </div>
    {{#GM}}
    <div class="fakebutton pb-room-loot" data-pc-loot data-tooltip="Player loots a room or container">
        <i class="fa-regular">ROOM LOOT</i>
    </div>
    {{/GM}}
    {{#LesserThan system.health.value 1}}
    <div class="pb-deathsaves">
        <div class="pb-deathsaves-title">Death Saving Rolls</div>
        <div class="grid grid-4col pb-deathsaves-row">
            <div>Live</div>
            <div>
                <i data-save1
                   class="{{#if system.saveSuccesses.first}}fas fa-heartbeat{{else}}far fa-circle{{/if}}"></i>
            </div>
            <div>
                <i data-save2
                   class="{{#if system.saveSuccesses.second}}fas fa-heartbeat{{else}}far fa-circle{{/if}}"></i>
            </div>
            <div>
                <i data-save3
                   class="{{#if system.saveSuccesses.third}}fas fa-heartbeat{{else}}far fa-circle{{/if}}"></i>
            </div>
        </div>
        <div class="grid grid-4col pb-deathsaves-row">
            <div>Die</div>
            <div>
                <i data-fail1
                   class="{{#if system.saveFailures.first}}fas fa-skull{{else}}far fa-circle{{/if}}"></i>
            </div>
            <div>
                <i data-fail2
                   class="{{#if system.saveFailures.second}}fas fa-skull{{else}}far fa-circle{{/if}}"></i>
            </div>
            <div>
                <i data-fail3
                   class="{{#if system.saveFailures.third}}fas fa-skull{{else}}far fa-circle{{/if}}"></i>
            </div>
        </div>
        <div class="fakebutton pb-rolldeathsave" data-apusage="2" {{#GreaterThan system.actionPoints.value 1}} data-rolldeathsave{{/GreaterThan}}>Roll Death Save</div>
    </div>
    {{/LesserThan}}
</div>
