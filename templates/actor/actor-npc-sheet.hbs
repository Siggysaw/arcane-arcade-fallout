<form autocomplete="off" {{#PipBoyEffects}}class="pipboy-crt"{{/PipBoyEffects}}>
  <div class="character{{#isVaultTec}} vaulttec {{/isVaultTec}}{{ cssClass }} {{ actor.type }} flexcol">
      {{log cssClass}}
    {{!-- Sheet Header --}}
    <header class="pipboy-header sheet-header">
        <div class="header-fields">
            <div class="pipboy-util-row">
                <div class="pipboy-util-group">
                    <span class="pipboy-util-item" data-tooltip="Toggle Edit Mode"
                        >Edit<i
                            data-editToggle
                            class="fas fa-toggle-{{#if system.editToggle}}on{{else}}off{{/if}}"
                        ></i
                    ></span>
                </div>
                <div class="pipboy-util-group">
                    <i data-audioToggle
                       data-tooltip="Toggle Audio Sounds Mode"
                       class="fas fa-volume-{{#PlaySounds}}up{{else}}mute{{/PlaySounds}}"></i>
                    <i data-pipboyEffectsToggle
                       data-tooltip="Toggle Pipboy Glitch Effects"
                       class="fas fa-toggle-{{#PipBoyEffects}}on{{else}}off{{/PipBoyEffects}}"></i>
                </div>
            </div>

            <div class="pipboy-header-grid">
                <div class="pb-bio-column">
                    {{>
                "systems/arcane-arcade-fallout/templates/actor/npc-heading/bio.hbs"
                name=actor.name
                races=races
                backgrounds=backgrounds
                level=system.level
                xp=system.xp
                carryLoad=system.carryLoad
                    }}
                    <div class="pb-passive-row">
                        <div class="pb-passive-stat" data-tooltip="Healing Rate <hr> {{system.healingRate.value}} (End + Lvl)/2 &#013;Modifiers: {{system.healingRate.modifiers}} &#013;Manual Edits: {{system.healingRate.base}}">
                            <i class="fas fa-heart"></i>
                            <div class="pb-passive-value">
                                {{#if system.editToggle}}<i data-statSubtraction data-stat="healingRate" data-type="" class="fas fa-minus-square nobackground pb-passive-step"></i>{{/if}}
                                <span>{{system.healingRate.value}}</span>
                                {{#if system.editToggle}}<i data-statAddition data-stat="healingRate" data-type="" class="fas fa-plus-square nobackground pb-passive-step"></i>{{/if}}
                            </div>
                        </div>
                        <div class="pb-passive-stat" data-tooltip="Combat Sequence <hr> To Roll Intiative, Utilize Combat Tracker">
                            <i class="fas fa-dice-d20"></i>
                            <div class="pb-passive-value">
                                {{#if system.editToggle}}<i data-statSubtraction data-stat="combatSequence" data-type="" class="fas fa-minus-square nobackground pb-passive-step"></i>{{/if}}
                                <span>{{system.combatSequence.value}}</span>
                                {{#if system.editToggle}}<i data-statAddition data-stat="combatSequence" data-type="" class="fas fa-plus-square nobackground pb-passive-step"></i>{{/if}}
                            </div>
                        </div>
                        <div class="pb-passive-stat" data-tooltip="Passive Sense <hr> 12 + Perception Mod ( {{system.abilities.per.mod}} ) {{#DifferentFrom system.passiveSense.base 0}} + Manual adjustments ({{system.passiveSense.base}}){{/DifferentFrom}} {{#DifferentFrom system.passiveSense.modifiers 0}} + Effects ( {{system.passiveSense.modifiers}} ){{/DifferentFrom}}">
                            <i class="fas fa-eye"></i>
                            <div class="pb-passive-value">
                                {{#if system.editToggle}}<i data-statSubtraction data-stat="passiveSense" data-type="" class="fas fa-minus-square nobackground pb-passive-step"></i>{{/if}}
                                <span>{{system.passiveSense.value}}</span>
                                {{#if system.editToggle}}<i data-statAddition data-stat="passiveSense" data-type="" class="fas fa-plus-square nobackground pb-passive-step"></i>{{/if}}
                            </div>
                        </div>
                        <div class="pb-passive-stat rollable"
                             data-roll-save="{{system.radiationDC.value}}"
                             data-save-type="radiation"
                             data-tooltip="Radiation DC <hr> D20 - PenaltyTotal({{penaltyTotal}}) against Radiation. Roll {{system.radiationDC.value}} or higher to succeed. On Fail gain level of Radiation">
                            <i class="fas fa-radiation-alt"></i>
                            <div class="pb-passive-value">
                                <span>{{system.radiationDC.value}}</span>
                            </div>
                        </div>
                        <div class="pb-passive-stat" data-tooltip="Total Penalties to subtract from rolls">
                            <i class="fas fa-skull"></i>
                            <div class="pb-passive-value">
                                {{#if system.editToggle}}
                                <i data-statSubtraction data-stat="hunger" data-type="penalties" class="fas fa-minus-square nobackground pb-passive-step"></i>
                                <span>{{system.penalties.hunger.value}}</span>
                                <i data-statAddition data-stat="hunger" data-type="penalties" class="fas fa-plus-square nobackground pb-passive-step"></i>
                                {{/if}}
                            </div>
                        </div>
                    </div>
                </div>
                {{>
                "systems/arcane-arcade-fallout/templates/actor/npc-heading/status.hbs"
                health=system.health
                stamina=system.stamina
                actionPoints=system.actionPoints
                armorClass=system.armorClass
                damageThreshold=system.damageThreshold
                }}
                {{>
                "systems/arcane-arcade-fallout/templates/actor/npc-heading/image.hbs"
                actor=actor
                caps=system.caps
                }}
            </div>
        </div>
    </header>
    {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="primary">
      {{!-- Default tab is specified in actor-sheet.mjs --}}
      <a class="item" data-tabs data-tab="status">STATUS</a>
      <a class="item allcaps" data-tabs data-tab="backpack">{{localize 'FALLOUTZERO.Common.Backpack'}}</a>
      <a class="item allcaps" data-tabs data-tab="backpack" data-crafting-bench>{{localize 'FALLOUTZERO.Common.Crafting'}}</a>
      <a class="item" data-tabs data-tab="effects">EFFECTS</a>
  </nav>

    {{!-- Sheet Body --}}
    <section class="sheet-body">
      <div class="abilities flexcol">
        <div class="ability flexrow flex-group-center"></div>
      </div>
      {{!-- Owned status Tab --}}
      <div class="tab status" data-group="primary" data-tab="status">
          <section>
              {{> "systems/arcane-arcade-fallout/templates/actor/parts/actor-items.hbs"}}
              {{> "systems/arcane-arcade-fallout/templates/actor/status/special.hbs"
                     abilities=system.abilities
               }}
              <div class="grid grid-10col">
                <div class="grid-span-3">
                {{>
                    "systems/arcane-arcade-fallout/templates/actor/status/skills.hbs"
                    startingSkillpoints=system.startingSkillpoints
                    skillPool=system.skillPool
                    skills=system.skills
                    abilities=system.abilities
                    penaltyTotal=system.penaltyTotal
                 }}
                    </div>
             <div class="grid-span-7">
                {{> "systems/arcane-arcade-fallout/templates/actor/parts/actor-npc-notes.hbs"}}
            </div>
                  </div>
          </section>
      </div>

      {{!-- Backpack Tab --}}
      <div class="tab backpack" data-group="primary" data-tab="backpack">
        {{> "systems/arcane-arcade-fallout/templates/actor/parts/actor-backpack.hbs"}}
      </div>
      {{!-- Notes Tab --}}
      <div class="tab notes" data-group="primary" data-tab="notes">
      </div>
      {{!-- Effects Tab --}}
      <div class="tab effects" data-group="primary" data-tab="effects">
        {{> "systems/arcane-arcade-fallout/templates/actor/parts/actor-effects.hbs"}}
      </div>
    </section>
  </div>
</form>
{{log actor}}
