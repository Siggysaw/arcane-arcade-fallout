<div class="dv-strip">
    {{#each this.drdv as |t|}}
    <div class="dv-chip {{t.id}} state-{{t.state}}"
         data-drdv-chip
         data-type-id="{{t.id}}"
         data-tooltip="{{t.label}} — {{t.stateLabel}} (left-click: cycle forward, right-click: cycle back)">
        {{#if t.faIcon}}<i class="fas {{t.faIcon}}"></i>{{/if}}
    </div>
    {{/each}}
</div>
<div class="dv-legend">
    <span class="dv-legend-item state-neutral">Neutral</span>
    <span class="dv-legend-item state-resist">Resist (½)</span>
    <span class="dv-legend-item state-immune">Immune</span>
    <span class="dv-legend-item state-vulnerable">Vulnerable (2×)</span>
</div>
