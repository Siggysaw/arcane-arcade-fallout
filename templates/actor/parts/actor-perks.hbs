{{#each traits as |item id|}}
<div class="box-perks">
    <li class="item flexrow" data-item-id="{{ item._id }}">
        <table class="perk-table pb-accent-border">
            <tr>
                <td>
                    <div class="perk-div">
                        <h3>{{ item.name }} {{#if item.system.wildWasteland}}[WW]{{/if}}</h3>
                        <div class="perk-div {{#if item.system.wildWasteland}}wildwasteland{{/if}}" style="text-align:left;">
                            <i class="fas fa-ellipsis-v context-menu context-icon perk-context" data-item-id="{{ item._id }}"></i>
                        </div>
                        <a class="item-control"
                           data-edit
                           data-item-id="{{ item._id }}"
                           title="View Item Details">
                            <img data-tooltip="{{ system.description }}" class="perk-image" src="{{ item.img }}" />
                        </a>
                    </div>
                    <div class="perk-div">
                        <i style="padding: 3px"
                           data-item="{{ item._id }}"
                           class="fas fa-minus-square"></i>
                        TRAIT
                        <i style="padding: 3px"
                           data-item="{{ item._id }}"
                           class="fas fa-plus-square"></i>
                    </div>
                </td>
            </tr>
        </table>
    </li>
</div>
{{/each}}

{{#each perks as |item id|}}
<div class="box-perks">
    <li class="item flexrow" data-item-id="{{ item._id }}">
        <table class="perk-table pb-accent-border">
            <tr>
                <td>
                    <div class="perk-div">
                        <h3>{{ item.name }}</h3>
                        <div class="perk-div" style="text-align:left;">
                            <i class="fas fa-ellipsis-v context-menu context-icon perk-context" data-item-id="{{ item._id }}"></i>
                            {{#if (eq item.name "Efficient Munitions")}}
                            <select style="float:right;margin-top:-5px" data-efficient-munitions-mode data-item-id="{{ item._id }}">
                                <option value="true" {{#if item.system.efficientMunitions}} selected{{/if}}>Crafting Doubled</option>
                                <option value="false" {{#unless item.system.efficientMunitions}} selected{{/unless}}>Efficient Rounds</option>
                            </select>
                            {{/if}}
                            {{#if (eq item.name "Rooted")}}
                            <button type="button"
                                    class="perk-toggle-btn"
                                    data-rooted-toggle
                                    data-item-id="{{ item._id }}">
                                {{#if item.rootedConditionActive}}Deactivate{{else}}Activate{{/if}}
                            </button>
                            {{/if}}
                            {{#if (eq item.name "Made of Sterner Stuff")}}
                            <button type="button"
                                    class="perk-toggle-btn"
                                    data-block-toggle
                                    data-item-id="{{ item._id }}">
                                {{#if item.blockingConditionActive}}Unblock{{else}}Block{{/if}}
                            </button>
                            {{/if}}

                        </div>
                        <a class="item-control"
                           data-edit
                           data-item-id="{{ item._id }}"
                           title="View Item Details">
                            <img data-tooltip="{{ system.description }}" class="perk-image" src="{{ item.img }}" />
                        </a>
                    </div>
                    <div class="perk-div">
                        <i style="padding: 3px"
                           data-itemsubtraction
                           data-item="{{ item._id }}"
                           class="fas fa-minus-square"></i>
                        {{ system.quantity }}
                        <i style="padding: 3px"
                           data-itemaddition
                           data-item="{{ item._id }}"
                           class="fas fa-plus-square"></i>

                    </div>

                </td>
            </tr>
        </table>
    </li>
</div>
{{/each}}
