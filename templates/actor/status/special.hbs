<div class="ps-panel ps-panel-special">
    <div class="pb-eyebrow">S.P.E.C.I.A.L.</div>
    <div class="ps-special-row">
        {{#each abilities as |ability key|}}
        <div class="ps-special-card">
            <label for="system.abilities.{{ key }}.value"
                   class="ps-special-abbr rollable specials"
                   data-tooltip="1d20 + {{ability.label}} Mod ( {{ability.mod}} ){{#DifferentFrom ../system.penaltyTotal 0}} -  Penalties ( {{../system.penaltyTotal}} ){{/DifferentFrom}} {{#GreaterThan ability.advantage 1}} with advantage {{/GreaterThan}}{{#LesserThan ability.advantage 0}} with disadvantage {{/LesserThan}}"
                   data-abilityroll="{{key}}"
                   data-roll="d20+{{ ability.mod }}{{#if ability.penalties}}-@penaltyTotal{{/if}}"
                   data-advantage="{{ ability.advantage }}"
                   data-pipboyselect
                   data-label="{{ ability.label }}">{{ ability.abbr }}</label>
            {{#if ../system.editToggle}}
            <div class="ps-special-steppers">
                <button type="button" class="w-auto no-background" data-statSubtraction data-stat="{{ ability.abbr }}" data-type="abilities">
                    <i class="fas fa-minus-square"></i>
                </button>
                <button type="button" class="w-auto no-background" data-statAddition data-stat="{{ ability.abbr }}" data-type="abilities">
                    <i class="fas fa-plus-square"></i>
                </button>
            </div>
            {{/if}}
            <span class="ps-special-value skillvalue">{{ability.value}}</span>
            <div class="ps-special-mod ability-mod" data-label="{{ ability.label }}">{{numberFormat ability.mod decimals=0 sign=true }}</div>
        </div>
        {{/each}}
    </div>
</div>
