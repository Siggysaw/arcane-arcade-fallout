<div class="ps-panel">
    <div class="pb-eyebrow">Status</div>
    <div class="ps-needs-row">
        <div class="ps-need-cell">
            <p class="ps-need-label condition" data-condition="Food_and_Drinks">{{localize 'FALLOUTZERO.Passives.hunger.label'}}</p>
            <div class="ps-need-controls" data-tooltip="Base: {{system.penalties.hunger.base}} Modifiers: {{system.penalties.hunger.modifiers}}">
                <i data-statSubtraction data-stat="hunger" data-type="penalties" class="fas fa-minus-square nobackground"></i>
                <span class="ps-need-value">{{system.penalties.hunger.value}}</span>
                <i data-statAddition data-stat="hunger" data-type="penalties" class="fas fa-plus-square nobackground"></i>
            </div>
        </div>
        <div class="ps-need-cell">
            <p class="ps-need-label condition" data-condition="Food_and_Drinks">{{localize 'FALLOUTZERO.Passives.dehydration.label'}}</p>
            <div class="ps-need-controls" data-tooltip="Base: {{system.penalties.dehydration.base}} Modifiers: {{system.penalties.dehydration.modifiers}}">
                <i data-statSubtraction data-stat="dehydration" data-type="penalties" class="fas fa-minus-square nobackground"></i>
                <span class="ps-need-value">{{system.penalties.dehydration.value}}</span>
                <i data-statAddition data-stat="dehydration" data-type="penalties" class="fas fa-plus-square nobackground"></i>
            </div>
        </div>
        <div class="ps-need-cell">
            <p class="ps-need-label condition" data-condition="Fatigue_and_Exhaustion">{{localize 'FALLOUTZERO.Passives.fatigue.label'}}</p>
            <div class="ps-need-controls" data-tooltip="Base: {{system.penalties.fatigue.base}} Modifiers: {{system.penalties.fatigue.modifiers}}">
                <i data-statSubtraction data-stat="fatigue" data-type="penalties" class="fas fa-minus-square nobackground"></i>
                <span class="ps-need-value">{{system.penalties.fatigue.value}}</span>
                <i data-statAddition data-stat="fatigue" data-type="penalties" class="fas fa-plus-square nobackground"></i>
            </div>
        </div>
        <div class="ps-need-cell">
            <p class="ps-need-label condition" data-condition="Fatigue_and_Exhaustion">{{localize 'FALLOUTZERO.Passives.exhaustion.label'}}</p>
            <div class="ps-need-controls" data-tooltip="Base: {{system.penalties.exhaustion.base}} Modifiers: {{system.penalties.exhaustion.modifiers}}">
                <i data-statSubtraction data-stat="exhaustion" data-type="penalties" class="fas fa-minus-square nobackground"></i>
                <span class="ps-need-value">{{system.penalties.exhaustion.value}}</span>
                <i data-statAddition data-stat="exhaustion" data-type="penalties" class="fas fa-plus-square nobackground"></i>
            </div>
        </div>
        <div class="ps-need-cell" data-tooltip="10 Levels of Rads = Dead">
            <p class="ps-need-label">
                <a class="content-link"
                   data-link=""
                   data-uuid="Compendium.arcane-arcade-fallout.conditions.Item.0KeR41HcadOH78KN"
                   data-id="0KeR41HcadOH78KN"
                   data-type="Item"
                   data-pack="arcane-arcade-fallout.conditions"
                   data-tooltip="Click for details.">{{localize 'FALLOUTZERO.Passives.rad_lvl.label'}}</a>
            </p>
            <div class="ps-need-controls" data-tooltip="Base: {{system.penalties.radiation.base}} Modifiers: {{system.penalties.radiation.modifiers}}">
                <i data-statSubtraction data-stat="radiation" data-type="penalties" class="fas fa-minus-square nobackground"></i>
                <span class="ps-need-value">{{system.penalties.radiation.value}}</span>
                <i data-statAddition data-stat="radiation" data-type="penalties" class="fas fa-plus-square nobackground"></i>
            </div>
        </div>
        <div class="ps-need-cell">
            <p class="ps-need-label condition" data-condition="Hypothermia">{{localize 'FALLOUTZERO.Passives.hypothermia.label'}}</p>
            <div class="ps-need-controls" data-tooltip="Base: {{system.penalties.hypothermia.base}} Modifiers: {{system.penalties.hypothermia.modifiers}}">
                <i data-statSubtraction data-stat="hypothermia" data-type="penalties" class="fas fa-minus-square nobackground"></i>
                <span class="ps-need-value">{{system.penalties.hypothermia.value}}</span>
                <i data-statAddition data-stat="hypothermia" data-type="penalties" class="fas fa-plus-square nobackground"></i>
            </div>
        </div>
        <div class="ps-need-cell">
            <p class="ps-need-label condition" data-condition="Overheating">{{localize 'FALLOUTZERO.Passives.overheating.label'}}</p>
            <div class="ps-need-controls" data-tooltip="Base: {{system.penalties.overheating.base}} Modifiers: {{system.penalties.overheating.modifiers}}">
                <i data-statSubtraction data-stat="overheating" data-type="penalties" class="fas fa-minus-square nobackground"></i>
                <span class="ps-need-value">{{system.penalties.overheating.value}}</span>
                <i data-statAddition data-stat="overheating" data-type="penalties" class="fas fa-plus-square nobackground"></i>
            </div>
        </div>
    </div>
    <div class="ps-rad-row" data-tooltip="Every 10 levels resets and gives 1 level radiation">
        <p class="ps-need-label condition" data-condition="Irradiation" style="margin:0;white-space:nowrap;">{{localize 'FALLOUTZERO.Passives.irradiation.label'}}</p>
        <div class="ps-rad-bar-wrap">
            <i data-subtracted data-field="system.irradiated" data-fieldvalue="{{irradiated}}" class="fas fa-minus-square nobackground"></i>
            <progress data-tooltip="{{irradiated}} out of 10"
                      class="ps-rad-bar"
                      value="{{ irradiated }}"
                      max="10">
                {{ irradiated }}
            </progress>
            <i data-added data-field="system.irradiated" data-fieldvalue="{{irradiated}}" class="fas fa-plus-square nobackground"></i>
        </div>
    </div>
    <div class="ps-penalty-total">
        <span>{{localize 'FALLOUTZERO.RollData.Penalties'}}</span>
        <b>{{ penaltyTotal }}</b>
    </div>
</div>
