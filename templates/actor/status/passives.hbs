<div class="ps-panel">
    <div class="pb-eyebrow">Passives</div>
    <div class="ps-passive-grid">
        <div class="ps-passive-cell" data-tooltip="Calculated: {{system.healingRate.value}} (End + Lvl)/2 &#013;Modifiers: {{system.healingRate.modifiers}} &#013;Manual Edits: {{system.healingRate.base}}">
            <div class="ps-passive-label">{{localize 'FALLOUTZERO.Passives.healing_rate.label'}}</div>
            <div class="ps-passive-row2">
                {{#if system.editToggle}}<div class="ps-passive-editrow"><i data-statSubtraction data-stat="healingRate" data-type="" class="fas fa-minus-square nobackground"></i></div>{{/if}}
                <span class="ps-passive-value">{{system.healingRate.value}}</span>
                {{#if system.editToggle}}<div class="ps-passive-editrow"><i data-statAddition data-stat="healingRate" data-type="" class="fas fa-plus-square nobackground"></i></div>{{/if}}
            </div>
        </div>
        <div class="ps-passive-cell" data-tooltip="To Roll Intiative, Utilize Combat Tracker">
            <div class="ps-passive-label">{{localize 'FALLOUTZERO.Passives.combat_sequence.label'}}</div>
            <div class="ps-passive-row2">
                {{#if system.editToggle}}<div class="ps-passive-editrow"><i data-statSubtraction data-stat="combatSequence" data-type="" class="fas fa-minus-square nobackground"></i></div>{{/if}}
                <span class="ps-passive-value">{{system.combatSequence.value}}</span>
                {{#if system.editToggle}}<div class="ps-passive-editrow"><i data-statAddition data-stat="combatSequence" data-type="" class="fas fa-plus-square nobackground"></i></div>{{/if}}
            </div>
        </div>
        <div class="ps-passive-cell rollable"
             data-roll-save="{{system.radiationDC.value}}"
             data-save-type="radiation"
             data-tooltip="D20 - PenaltyTotal({{penaltyTotal}}) against Radiation. Roll {{system.radiationDC.value}} or higher to succeed. On Fail gain level of Radiation">
            <div class="ps-passive-label"><i class="fas fa-dice-d20"></i>{{localize 'FALLOUTZERO.Passives.rad_dc.label'}}</div>
            <div class="ps-passive-row2">
                {{#if system.editToggle}}<div class="ps-passive-editrow"><i data-statSubtraction data-stat="radiationDC" data-type="" class="fas fa-minus-square nobackground"></i></div>{{/if}}
                <span class="ps-passive-value">{{system.radiationDC.value}}</span>
                {{#if system.editToggle}}<div class="ps-passive-editrow"><i data-statAddition data-stat="radiationDC" data-type="" class="fas fa-plus-square nobackground"></i></div>{{/if}}
            </div>
        </div>
        <div class="ps-passive-cell" data-tooltip="12 + Perception Mod ( {{system.abilities.per.mod}} ) {{#DifferentFrom system.passiveSense.base 0}} + Manual adjustments ({{system.passiveSense.base}}){{/DifferentFrom}} {{#DifferentFrom system.passiveSense.modifiers 0}} + Effects ( {{system.passiveSense.modifiers}} ){{/DifferentFrom}}">
            <div class="ps-passive-label">{{localize 'FALLOUTZERO.Passives.passive_sense.label'}}</div>
            <div class="ps-passive-row2">
                {{#if system.editToggle}}<div class="ps-passive-editrow"><i data-statSubtraction data-stat="passiveSense" data-type="" class="fas fa-minus-square nobackground"></i></div>{{/if}}
                <span class="ps-passive-value">{{system.passiveSense.value}}</span>
                {{#if system.editToggle}}<div class="ps-passive-editrow"><i data-statAddition data-stat="passiveSense" data-type="" class="fas fa-plus-square nobackground"></i></div>{{/if}}
            </div>
        </div>
        <div class="ps-passive-cell computed" data-tooltip="Party Charisma Mods Added together divided by 2">
            <div class="ps-passive-label">{{localize 'FALLOUTZERO.Passives.party_nerve.label'}}</div>
            <div class="ps-passive-row2"><span class="ps-passive-value">{{#Sum system.partyNerve.base system.partyNerve.modifiers }}{{/Sum}}</span></div>
        </div>
        <div class="ps-passive-cell computed" data-tooltip="Party Sneak Total divided by Player Number">
            <div class="ps-passive-label">{{localize 'FALLOUTZERO.Passives.group_sneak.label'}}</div>
            <div class="ps-passive-row2"><span class="ps-passive-value">{{#Sum system.groupSneak.base system.groupSneak.modifiers }}{{/Sum}}</span></div>
        </div>
    </div>
</div>
