<fieldset>
    <legend>Death Save Roll Details</legend>
    <div class="flex space-between">
        <div>Dice: </div>
        <div>
            <select id="rollAbility" name="rollAbility">
                <option value="end">Endurance</option>
                <option value="lck">Luck</option>
            </select>
        </div>
    </div>
    <div class="flex space-between">
        <div>Modifiers: </div><div>
            <select id="modified" name="modified">
                <option value="true">With Modifiers</option>
                <option value="false">No Modifiers</option>
            </select>
        </div>
    </div>

    <div class="flex space-between">
        <div>Roll Type: </div>
        <div>
            <select id="advantage" name="advantage">
                <option value="false">Normal</option>
                <option value="kh">Advantaged</option>
                <option value="kl">Disdvantaged</option>
            </select>
        </div>
    </div>
     <div class="flex space-between">
        <div>Bonus: </div><div><input id="bonus" name="bonus" type="text" placeholder="1d4 + 10"></div>
    </div>
</fieldset>
