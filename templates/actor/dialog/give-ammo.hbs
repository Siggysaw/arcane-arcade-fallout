<div class="give-ammo-dialog">
    <div class="give-ammo-header">
        <img class="give-ammo-img" src="{{img}}" alt="{{name}}">
        <div class="give-ammo-name">{{name}}</div>
    </div>
    <form autocomplete="off">
        <div class="form-group give-ammo-controls">
            <label>Quantity</label>
            <div style="flex:10" class="give-ammo-inputs">
                <input type="range" name="quantitySlider" min="0" max="{{max}}" step="1" value="{{quantity}}">
                <input type="number" name="quantity" min="0" step="1" value="{{quantity}}">
            </div>
        </div>
    </form>
</div>
