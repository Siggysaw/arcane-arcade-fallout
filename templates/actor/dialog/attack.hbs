<form autocomplete="off">
    <div style="display:none;"><input type="text" name="weaponType" value="{{weaponType}}"></div>
    <div class="form-group attack-dialog">
        <fieldset>
            <legend>Bonuses / Penalties</legend>
            <div class="flex space-between">
                <div>Skill Bonus:</div>
                <div class="value">{{ skillBonus }}</div>
            </div>
            <div class="flex space-between">
                <div>Perks/Equipment Bonus:</div>
                <div class="value">{{ attackBonus }}</div>
            </div>
            <div class="flex space-between">
                <div>Ability Bonus:</div>
                <div class="value">{{ abilityBonus }}</div>
            </div>
            <div class="flex space-between">
                <div>Luck:</div>
                <div class="value">{{ actorLuck }}</div>
            </div>
            <div class="flex space-between">
                <div>Decay Penalty:</div>
                <div class="value">{{#Multiply decayPenalty -1 }}{{/Multiply}}</div>
            </div>
            <div class="flex space-between">
                <div>Penalties:</div>
                <div class="value">{{#Multiply actorPenalties -1 }}{{/Multiply}}</div>
            </div><hr />
            <div class="flex space-between">
                <div>Total Bonuses:</div>
                <div class="value">{{ totalBonus }}</div>
            </div>
        </fieldset>
    </div>
    <div class="form-group">
        <fieldset>
            <legend>Select Normal / Advantage / Disadvantage</legend>
            <div>
                <input type="radio"
                       id="normal"
                       name="advantageMode"
                       value="1"
                       {{{setChecked advantageMode 1}}} />
                <label for="normal">Normal</label>
            </div>
            <div>
                <input type="radio"
                       id="advantage"
                       name="advantageMode"
                       value="2"
                       {{{setChecked advantageMode 2}}} />
                <label for="advantage">Advantage</label>
            </div>
            <div>
                <input type="radio"
                       id="disadvantage"
                       name="advantageMode"
                       value="3"
                       {{{setChecked advantageMode 3}}} />
                <label for="disadvantage">Disadvantage</label>
            </div>
            <div data-tooltip="Target beyond long range, Nat 20 required to hit">
                <input type="radio"
                       id="hailmary"
                       name="advantageMode"
                       value="4"
                       {{{setChecked advantageMode 4}}} />
                <label for="hailmary">Hail Mary!</label>
            </div>
        </fieldset>
    </div>

    <div class="form-group">
        <fieldset>
            <legend>Overrides</legend>

            <div class="override-row">
                <div class="override-label">AP Cost</div>
                <div class="override-control">
                    {{#if overrideAp}}
                    <button type="button" class="stepper-btn" data-override-ap="dec"><i class="fas fa-minus"></i></button>
                    <span class="stepper-value">{{ adjustedApCost }}</span>
                    <button type="button" class="stepper-btn" data-override-ap="inc"><i class="fas fa-plus"></i></button>
                    {{else}}
                    <span class="stepper-value static">{{ totalApCost }}</span>
                    {{/if}}
                    <button type="button" class="override-toggle {{#if overrideAp}}active{{/if}}" data-toggle-override="ap">
                        <i class="fas fa-sliders-h"></i>
                    </button>
                </div>
            </div>

            {{#if targeted}}
            <div class="override-row">
                <div class="override-label">Targeted ({{ targeted.target }})</div>
                <div class="override-control"><span class="stepper-value static">{{ targeted.cost }}</span></div>
            </div>
            {{/if}}
            <div class="override-row">
                <div class="override-label">Ammo Cost</div>
                <div class="override-control">
                    {{#if overrideAmmo}}
                    <button type="button" class="stepper-btn" data-override-ammo="dec"><i class="fas fa-minus"></i></button>
                    <span class="stepper-value">{{ adjustedAmmoCost }}</span>
                    <button type="button" class="stepper-btn" data-override-ammo="inc"><i class="fas fa-plus"></i></button>
                    {{else}}
                    <span class="stepper-value static">{{ totalAmmoCost }}</span>
                    {{/if}}
                    <button type="button" class="override-toggle {{#if overrideAmmo}}active{{/if}}" data-toggle-override="ammo">
                        <i class="fas fa-sliders-h"></i>
                    </button>
                </div>
            </div>

            <!-- Attack Modifiers -->
            {{#if hasAutomatic}}
            <div class="flex space-between">
                <label data-tooltip="If you are using a weapon with the Automatic Property, check this for the bonus shots after the first." for="automatic">Automatic Attack</label>
                <input type="checkbox" name="automaticAttack" {{checked automaticAttack}} />
            </div>
            {{/if}}
            {{#if hasOverclockedCapacitor}}
            <div class="flex space-between">
                <label data-tooltip="Overclocked Attack! Spend 3 bullets for 4 extra damage">Overclocked Capacitor</label>
                <input type="checkbox" name="overClocked" {{checked overClocked}} />
            </div>
            {{/if}}
            {{#if hasBoostedCapacitor}}
            <div class="flex space-between">
                <label data-tooltip="Boosted Attack! Spend 2 bullets for 2 extra damage">Boosted Capacitor</label>
                <input type="checkbox" name="boosted" {{checked boosted}} />
            </div>
            {{/if}}
            {{#if hasFanTheHammer}}
            <div class="flex space-between">
                <label data-tooltip="Spend 1 Karma Cap and 10 AP to Fan The Hammer and use all your ammo!{{#unless hasKarmaCapAvailable}} (No Karma Caps available!){{/unless}}">Fan The Hammer</label>
                <input type="checkbox" name="fanTheHammer" {{checked fanTheHammer}} {{#unless hasKarmaCapAvailable}} disabled{{/unless}} />
            </div>
            {{/if}}
        </fieldset>
    </div>

    <div class="form-group">
        <fieldset>
            <legend>Damage</legend>
            {{#each damages as |damage key|}}
            <div class="flex space-between">
                <div>Type:</div>
                {{#if damage.altType}}
                <select name="damage.{{ key }}.selectedDamageType">
                    <option>{{ damage.type }}</option>
                    <option>{{ damage.altType }}</option>
                </select>
                {{else}}
                {{ damage.selectedDamageType }}
                {{/if}}
            </div>
            <div class="flex space-between">
                <div>Formula:</div>
                <div>{{ damage.formula }}</div>
            </div>
            <div class="flex space-between">
                <div>Perk/Trait Bonus:</div>
                <div>{{#GreaterThan ../damageBonus 1}}+{{else}}-{{/GreaterThan}} {{../damageBonus }}</div>
            </div>
            {{/each}}
            <div class="flex space-between">
                <div>Critical Formula:</div>
                <div>{{ critical.formula }}</div>
            </div>
            <div class="flex space-between">
                <div>Critical Multiplier:</div>
                <div>{{ critical.multiplier }}</div>
            </div>
            {{#if critical.condition}}
            <div class="flex space-between">
                <div>Applies Condition:</div>
                <div>{{ critical.condition }}</div>
            </div>
            {{/if}}
        </fieldset>
    </div>
    <div class="attack-grid grid grid-4col">
        <div># Attacks</div>
        <div>Full Auto</div>
        <div>Bonus Hit</div>
        <div>Bonus DMG</div>
        <div><input id="repeat" type="number" name="repeat" value="{{ repeat }}" /></div>
        <div data-tooltip="use these settings to attack until you run out of AP or Ammo"><input type="checkbox" name="fullAuto" {{checked fullAuto}} /></div>
        <div><input type="text" name="bonus" value="{{ bonus }}" /></div>
        <div><input type="text" name="bonusdamage" value="{{ bonusdamage }}" /></div>
    </div>
    <hr />
    <div class="form-group">
        {{#unless targeted}}
        <button type="button" data-add-target>Targeted Attack</button>
        {{else}}
        <div class="targeted flex">
            <div>
                <div>Target: {{ targeted.target }}</div>
            </div>
            <div>
                <button type="button" data-remove-target><i class="fas fa-trash"></i></button>
            </div>
        </div>
        {{/unless}}
    </div>

    <div class="dialog-buttons flex">
        <button type="submit">Roll</button>
    </div>
</form>
{{ log 'attack' this}}
