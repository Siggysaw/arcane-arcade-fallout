<div class="level-up pipboy-frame{{#isVaultTec}} vaulttec {{/isVaultTec}}">
    <h3>
        {{#if isCharacterCreation}}
            Welcome to the Wasteland, {{ actor.name }}! Let's finish building your character.
        {{else}}
            Congrats {{ actor.name }} you're going from level {{ actor.system.level }} to {{ nextLevel }}
        {{/if}}
    </h3>
    <div class="rewards">
        {{#if needsRace}}
            <fieldset class="race-picker mx-1 my-2">
                <legend>Choose your Race</legend>
                {{#if newRace}}
                    <div class="creation-choice-name">{{ newRace.name }}</div>
                    <button data-action="chooseRace">Change Race</button>
                {{else}}
                    <button data-action="chooseRace">Choose Race</button>
                {{/if}}
            </fieldset>
        {{/if}}

        {{#if needsBackground}}
            <fieldset class="background-picker mx-1 my-2">
                <legend>Choose your Background</legend>
                {{#if newBackground}}
                    <div class="creation-choice-name">{{ newBackground.name }}</div>
                    <button data-action="chooseBackground">Change Background</button>
                {{else}}
                    <button data-action="chooseBackground">Choose Background</button>
                {{/if}}
            </fieldset>
        {{/if}}

        {{#if isCharacterCreation}}
            <fieldset class="special-pool mx-1 my-2">
                <legend>Assign your S.P.E.C.I.A.L. (points left: {{ specialPointPool }})</legend>
                <div class="grid grid-col2">
                    {{#each actor.system.abilities as |ability key|}}
                        <div>{{ ability.label }}</div>
                        <div class="flex space-evenly">
                            <button data-action="decSpecial" data-special="{{key}}">
                                <i class="fas fa-2x fa-minus-square"></i>
                            </button>
                            <div>{{ lookup ../specialChanges key }}</div>
                            <button data-action="incSpecial" data-special="{{key}}" {{#if (Equals ../specialPointPool 0)}}disabled{{/if}}>
                                <i class="fas fa-2x fa-plus-square"></i>
                            </button>
                        </div>
                    {{/each}}
                </div>
            </fieldset>
        {{/if}}

        {{#if hasSkillPoints}}
            <fieldset class="skills mx-1 my-2">
                <legend>You have skill points to spend</legend>
                <div>
                    Points left to spend: {{ skillPointPool }}
                </div>
                <div class="grid grid-col2">
                    {{#each skills as |skill key|}}
                        <div>{{ skill.label }}</div>
                        <div class="flex space-evenly">
                            <button data-action="decSkill" data-skill="{{key}}">
                                <i class="fas fa-2x fa-minus-square"></i>
                            </button>
                            <div>{{ lookup ../skillChanges key }}</div>
                            <button data-action="incSkill" data-skill="{{key}}" {{#if (Equals ../skillPointPool 0)}}disabled{{/if}}>
                                <i class="fas fa-2x fa-plus-square"></i>
                            </button>
                        </div>
                    {{/each}}
                </div>
            </fieldset>
        {{/if}}

        {{#if perkOrSpecial}}
            <fieldset class="perks mx-1 my-2">
                {{#if perkOnly}}
                    <legend>Choose a Perk</legend>
                    <div>
                        {{#if newPerk}}
                            <button data-action="choosePerk">{{ newPerk.name }}</button>
                        {{else}}
                            <button data-action="choosePerk">Choose perk</button>
                        {{/if}}
                    </div>
                {{else}}
                    <legend>You can take a Perk OR you can add +1 to a SPECIAL stat!</legend>
                    <div>
                        {{#if specialBoost}}
                            <button data-action="chooseSpecial">{{ specialBoost.label }}</button>
                        {{else if newPerk }}
                            <button data-action="choosePerk">{{ newPerk.name }}</button>
                        {{else}}
                            <button data-action="choosePerk">Choose perk</button>
                            <button data-action="chooseSpecial">Choose SPECIAL</button>
                        {{/if}}
                    </div>
                {{/if}}
            </fieldset>
        {{/if}}
    </div>

    <div class="flex my-2">
        <button class="w-full" type="submit" data-action="accept">Accept</button>
    </div>
</div>