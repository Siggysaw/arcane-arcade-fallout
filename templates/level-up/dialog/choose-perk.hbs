<div class="choose-perk pipboy-frame scrollable">
    <div class="perk-picker-header">
        <label class="perk-filter-toggle" data-tooltip="Only display perks of which you meet the requirements">
            <input data-action="filter" type="checkbox" name="onlyAvailablePerks" {{#if onlyAvailablePerks}} checked{{/if}} />
            Only available perks
        </label>
        <div class="search-row">
            <i class="fas fa-search"></i>
            <input type="search"
                   placeholder="Search Perks"
                   data-search
                   value="{{searchQuery}}"
                   autocomplete="off"
                   data-tooltip="Type to filter — Enter selects the only remaining match">
        </div>
        <button data-action="cancel">Cancel</button>
    </div>
    <div class="perk-grid" data-perk-grid>
        {{#each perks as |perk|}}
            <div class="perk" data-item-name="{{perk.name}}">
                <img
                    class="mx-auto"
                    src="{{perk.img}}"
                    width="100"
                    alt="{{perk.name}}"
                    data-tooltip="{{perk.name}}: {{perk.system.description}}"
                >
                {{#if perk.hasRequirements}}
                <div class="text-center">
                    <div class="underline">
                        requirements
                    </div>
                    {{#GreaterThan perk.system.lvlReq 2 }}
                        <div>
                            Lvl:{{ perk.system.lvlReq }}
                        </div>
                    {{/GreaterThan}}
                    {{#if (NotEqual perk.system.specialReq.special '' ) }}
                    {{#if (NotEqual perk.system.specialReq.special 'None' ) }}
                    <div class="perk-req-ability">
                        {{SpecialKeyToLabel perk.system.specialReq.special }}: {{ perk.system.specialReq.value }}
                    </div>
                    {{/if}}
                    {{/if}}

                    {{#if perk.system.raceReq }}
                    <div>
                        {{#each perk.system.raceReq as |raceReq|}} {{ raceReq.label }} {{/each}}
                    </div>
                    {{/if}}
                </div>
                {{/if}}
                <button
                    data-tooltip="{{perk.name}}"
                    data-action="perk"
                    data-perk-id="{{ perk.id }}"
                >
                    {{ perk.name }}
                </button>
            </div>
        {{/each}}
        <div class="empty-branch" data-empty-message hidden>No perks match your search</div>
    </div>
</div>