<div class="choose-special pipboy-frame">
    <div class="special-picker-list">
        {{#each specials as |special key|}}
            <button data-action="special" data-special-id="{{key}}">
                {{ special.label }}
            </button>
        {{/each}}
    </div>
    <div class="dialog-buttons">
        <button data-action="cancel">Cancel</button>
    </div>
</div>