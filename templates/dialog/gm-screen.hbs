<div class="gm-screen grid grid-20col {{#PipBoyEffects}}pipboy-crt{{/PipBoyEffects}}">
    <div class="grid-span-4 gm-sidebar" style="padding:5px;">

        <details class="sidebar-section" open>
            <summary><h6>Group Rewards</h6></summary>
            <div class="grid grid-2col group">
                <div class="label" data-tooltip='<h2 style="margin-top:0in;margin-right:0in;margin-bottom:.15pt;margin-left:
                -.25pt"><span style="font-family: Calibri, sans-serif"><strong ">Gaining XP</strong></span></h2>
                <p>The GM may award the players with XP at any time, but is typically awarded when the player characters spend any amount of time resting after completing a quest, encounter, or discovering something new. Whenever you gain XP, if your XP total is lower than any other player character&rsquo;s total XP, you gain XP equal to the difference between your total and theirs. (Simply put: everyone shares the same amount of XP, defaulting to whoever has the highest). Additionally, the following modifiers are added to the total.</p>
                <p><em ><strong>Reaching 0 Hit Points.</strong></em> A 10% bonus of XP is awarded for each player character that fell to 0 hit points.</p>
                <p><em ><strong>Death.</strong></em> 1000 XP is awarded to each player character if another player character permanently dies.</p>
                <p><em ><strong>Creature Discovery.</strong></em> A 20% bonus of XP is awarded if the player characters roll combat sequence with a creature they have never rolled combat sequence with before.</p>
                <p><em ><strong>Location Discovery.</strong></em> A 20% bonus of XP is awarded if the player characters rest in a city, town, ruin, dungeon, point of interest, or otherwise generalized location they have never rested in before.</p>
                <p></p>
                <p>Note: XP is not rewarded by killing people or monsters, it is instead rewarded for surviving encounters in the wasteland. Sometimes failure is the best teacher.</p>' >
                XP
                </div>
                <div class="label">
                    Caps
                </div>
                <div>
                    <input data-tooltip="Base Amount of XP to give the party" type="number" data-group-xp value="{{ groupXp }}">+
                    <input data-tooltip="Total Percentage Bonus" type="number" data-group-xp-modifier value="{{ groupXpmodifier }}">%
                </div>
                <div>
                    <input placeholder="Caps" type="number" data-group-caps value="{{ groupCaps }}">
                </div>
            </div>
            <div class="grid-span-4">
                <button class="prepare-rewards-button" type="button" data-action="divideGroup">Prepare Rewards</button>
            </div>
        </details>

        <div class="sidebar-section roster-section">
            <div class="sidebar-section-title">
                <h6>Party</h6>
                <label class="active-toggle">
                    <input data-activeOnly type="checkbox" name="activeOnly" {{checked activeOnly}}>
                    Active only
                </label>
            </div>
            <div class="grid grid-5col characters">
                <div class="grid-span-3 label"></div>
                <div class="label">XP</div>
                <div class="label">Caps</div>
                {{#if activeOnly}}
                {{#each actors as |actor|}}
                {{#if actor.system.activePartymember}}
                <div class="grid-span-3 name-label">
                    {{ actor.name }}
                </div>
                {{#with (lookup ../newActorData [id])~}}
                <div>
                    <input style="border:none;" placeholder="0" type="number" data-actor-xp="{{actor.id}}" value="{{ xp }}" disabled>
                </div>
                <div>
                    <input placeholder="0" type="number" data-actor-caps="{{actor.id}}" value="{{ caps }}">
                </div>
                {{/with}}
                {{/if}}
                {{/each}}
                {{else}}
                {{#each actors as |actor|}}
                <div class="grid-span-3 name-label">
                    {{ actor.name }}
                </div>
                {{#with (lookup ../newActorData [id])~}}
                <div>
                    <input style="border:none;" placeholder="0" type="number" data-actor-xp="{{actor.id}}" value="{{ xp }}" disabled>
                </div>
                <div>
                    <input placeholder="0" type="number" data-actor-caps="{{actor.id}}" value="{{ caps }}">
                </div>
                {{/with}}
                {{/each}}
                {{/if}}
            </div>
            <div class="dialog-buttons flexrow">
                <button class="dialog-button">Send Rewards</button>
                <button class="dialog-button" data-action="cancel">Cancel</button>
            </div>
        </div>

        <div class="sidebar-section quick-insert-section">
            <div class="sidebar-section-title">
                <h6>Add to Character</h6>
            </div>
            <div class="quick-inserts-search">
                <input type="text"
                       data-quick-insert-search
                       placeholder="Search Items To Add"
                       autocomplete="off"
                       data-tooltip-="Search any item from the compendium. Drag to Character Image to add to their sheet">
            </div>
            <div class="quick-inserts">
                {{#each packItems as |item|}}
                <div class="quick-buttons" data-item-name="{{item.name}}" data-item-type="{{item.packType}}">
                    <a class="content-link"
                       data-link=""
                       draggable="true"
                       data-uuid="{{item.uuid}}"
                       data-id="{{item.id}}"
                       data-type="Item"
                       data-tooltip="{{item.name}} ({{item.packLabel}})">
                        {{item.name}}
                    </a>
                </div>
                {{/each}}
            </div>
        </div>

        <details class="sidebar-section">
            <summary><h6>Cheat Sheets</h6></summary>
            <ul class="cheat-sheet-list unlist">
                <li><a data-link="" data-uuid="Compendium.arcane-arcade-fallout.properties.Item.31qCwzre2jXqsj8Y">Targeted Attacks</a></li>
                <li><a data-link="" data-uuid="Compendium.arcane-arcade-fallout.properties.Item.iVqR9MjAM473tFOq">Fall Damage</a></li>
                <li><a data-link="" data-uuid="Compendium.arcane-arcade-fallout.properties.Item.CcBnnoYRjG7In3lu">Travel / Terrain</a></li>
                <li><a data-link="" data-uuid="Compendium.arcane-arcade-fallout.properties.Item.jzbAUoWYLRMgCAyL">Damage Application</a></li>
            </ul>
        </details>

    </div>
    <div class="grid-span-16"
         style="border:none;">
        <div class="grid grid-4col character-details"
             style="border:none;">

            {{#each detailActors as |actor id|}}
            <div style="display:grid;grid-template-columns:auto 1fr auto;align-items:center;">
                <input type="checkbox"
                       data-action="toggleActivePartymember"
                       data-actor-id="{{actor.id}}"
                       data-tooltip="Active Party Member"
                       {{checked actor.system.activePartymember}}
                       style="justify-self:start;">
                <span style="justify-self:center;">{{actor.name}}</span>
                <button type="button" class="open-sheet-btn" data-action="openSheet" data-actor-id="{{actor.id}}" data-tooltip="Open Character Sheet" style="justify-self:end;">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                </button>
            </div>            <div>Status</div>
            <div>Perks/Traits</div>
            <div>Equipment</div>
            <div style="background-image:url('{{actor.img}}')"
                 class="character-stats actor-drop-target"
                 data-actor-drop="{{actor.id}}">
                <div class="karmaCaps" style="border:none;">
                    {{#each actor.system.karmaCaps as |flipped key|}}
                    <input type="checkbox"
                           name="system.karmaCaps.{{ key }}"
                           data-action="toggleKarmaCap"
                           data-actor-id="{{actor.id}}"
                           data-cap-index="{{ key }}"
                           {{checked flipped}} />
                    {{/each}}
                </div>
                <div class="actor-name stat-block">
                    <span class="character-bg">
                        Lvl {{actor.system.level}}
                        {{#each actor.items as |item id|}}
                        {{#Check item.type "background"}}
                        {{item.name}}
                        {{/Check}}
                        {{/each}}
                    </span>
                    <progress class="statusbar"
                              value="{{ actor.system.xp }}"
                              max="1000"
                              style="width:100%;height:5px;background:white;"
                              data-tooltip="{{actor.system.xp}} out of 1000xp">
                        {{ actor.system.xp }}
                    </progress>
                </div>
            </div>
            <div data-actor-drop="{{actor.id}}" class="character-stats actor-drop-target">
                <div class="grid grid-7col">
                    <div>S</div>
                    <div>P</div>
                    <div>E</div>
                    <div>C</div>
                    <div>I</div>
                    <div>A</div>
                    <div>L</div>
                    <div data-tooltip="{{#GreaterThan actor.system.abilities.str.mod 1}}+{{/GreaterThan}}{{actor.system.abilities.str.mod}}">{{actor.system.abilities.str.value}}</div>
                    <div data-tooltip="{{#GreaterThan actor.system.abilities.per.mod 1}}+{{/GreaterThan}}{{actor.system.abilities.per.mod}}">{{actor.system.abilities.per.value}}</div>
                    <div data-tooltip="{{#GreaterThan actor.system.abilities.end.mod 1}}+{{/GreaterThan}}{{actor.system.abilities.end.mod}}">{{actor.system.abilities.end.value}}</div>
                    <div data-tooltip="{{#GreaterThan actor.system.abilities.cha.mod 1}}+{{/GreaterThan}}{{actor.system.abilities.cha.mod}}">{{actor.system.abilities.cha.value}}</div>
                    <div data-tooltip="{{#GreaterThan actor.system.abilities.int.mod 1}}+{{/GreaterThan}}{{actor.system.abilities.int.mod}}">{{actor.system.abilities.int.value}}</div>
                    <div data-tooltip="{{#GreaterThan actor.system.abilities.agi.mod 1}}+{{/GreaterThan}}{{actor.system.abilities.agi.mod}}">{{actor.system.abilities.agi.value}}</div>
                    <div data-tooltip="{{#GreaterThan actor.system.abilities.lck.mod 1}}+{{/GreaterThan}}{{actor.system.abilities.lck.mod}}">{{actor.system.abilities.lck.value}}</div>
                </div>
                <div style="border:none;" class="conditions">
                    {{#each (lookup ../conditionsByActor actor.id) as |item|}}
                    <span class="condition-badge"
                          data-actor-id="{{actor.id}}"
                          data-condition-name="{{name}}"
                          data-tooltip="{{name}}<br><br>Left-Click for Details<br>Right-Click for removal/downgrade">
                        <a class="content-link" data-link="" draggable="true" data-uuid="{{item.uuid}}" data-id="{{item.id}}" data-type="Item"><img src="{{img}}" /></a>
                        {{#GreaterThan quantity 1}}<span class="condition-count">x{{quantity}}</span>{{/GreaterThan}}
                    </span>
                    {{/each}}
                </div>

                <div class="vitals-row">
                    <div class="vital-chip vital-primary" data-tooltip="Health">
                        <i class="fa-solid fa-heart"></i>
                        <span>{{actor.system.health.value}}/{{actor.system.health.max}}</span>
                    </div>
                    <div class="vital-chip vital-primary" data-tooltip="Stamina">
                        <i class="fa-solid fa-droplet"></i>
                        <span>{{actor.system.stamina.value}}/{{actor.system.stamina.max}}</span>
                    </div>
                    <div class="vital-chip vital-primary" data-tooltip="Action Points">
                        <i class="fa-solid fa-bolt"></i>
                        <span>{{actor.system.actionPoints.value}}/{{actor.system.actionPoints.max}}</span>
                    </div>
                    <div class="vital-chip" data-tooltip="Armor Class">
                        <i class="fa-solid fa-shield"></i>
                        <span>{{actor.system.armorClass.value}}</span>
                    </div>
                    <div class="vital-chip" data-tooltip="Damage Threshold">
                        <i class="fa-solid fa-shield-halved"></i>
                        <span>{{actor.system.damageThreshold.value}}</span>
                    </div>
                    <div class="vital-chip" data-tooltip="Penalties<hr />
                     Hunger: {{actor.system.penalties.hunger.value}}<br />
                     Dehydration: {{actor.system.penalties.dehydration.value}}<br />
                     Radiation: {{actor.system.penalties.radiation.value}}<br />
                     Fatigue: {{actor.system.penalties.fatigue.value}}<br />
                     Exhaustion: {{actor.system.penalties.exhaustion.value}}<br />">
                        <i class="fa-solid fa-skull"></i>
                        <span>-{{actor.system.penaltyTotal}}</span>
                    </div>
                    <div class="vital-chip" data-tooltip="Caps">
                        <i class="fa-solid fa-coins"></i>
                        <span>{{actor.system.caps}}</span>
                    </div>
                </div>
            </div>
            <div data-actor-drop="{{actor.id}}" class="gm-screen-perk-container actor-drop-target">
                {{#each actor.items as |item id|}}
                {{#Check item.type "trait"}}
                <div class="gm-screen-perk" data-tooltip="{{item.system.description}}">
                    <h3 class="gm-screen-perk-label">{{item.name}}{{#if item.system.wildWasteland}}<br />[WW]{{/if}}</h3>
                    <a class="content-link gm-screen-perk-img" data-link="" draggable="true" data-uuid="{{item.uuid}}" data-id="{{item.id}}" data-type="Item"><img data-tooltip="{{ item.description }}" class="gm-screen-perk-image" src="{{ item.img }}" /></a>
                </div>
                {{/Check}}
                {{#Check item.type "perk"}}
                <div class="gm-screen-perk" data-tooltip="{{item.system.description}}">
                    <h3 class="gm-screen-perk-label">{{item.name}}</h3>
                    <a class="content-link gm-screen-perk-img" data-link="" draggable="true" data-uuid="{{item.uuid}}" data-id="{{item.id}}" data-type="Item"><img data-tooltip="{{ item.description }}" class="gm-screen-perk-image" src="{{ item.img }}" /></a>
                </div>
                {{/Check}}
                {{/each}}
            </div>
            <div data-actor-drop="{{actor.id}}" class="valuable-items actor-drop-target">
                {{#each (lookup ../valuableItemsByActor actor.id) as |group|}}
                <div class="item-type-group">
                    <p class="item-type-label">{{group.label}}s</p>
                    <ul class="unlist">
                        {{#each group.items as |item|}}
                        <li class="gm-backpack-items-all" data-tooltip="{{item.name}}">
                            {{#if item.equipped}}<i class="fa-solid fa-square equipped-icon" data-tooltip="Equipped"></i>{{/if}}
                            <a class="content-link {{#unless item.equipped}}gm-screen-backpack-item{{/unless}}" data-link="" draggable="true" data-uuid="{{item.uuid}}" data-id="{{item.id}}" data-type="Item">{{item.name}}</a>
                            ({{item.quantity}})
                        </li>
                        {{/each}}
                    </ul>
                </div>
                {{/each}}
            </div>
            <div class="grid-span-4" style="border:none;"><br /></div>
            {{/each}}

        </div>
    </div>
</div>
