<section class="main pipboy-frame">
    <header class="item-header">
        <h1>Workbench</h1>
    </header>
    {{#if selectedCraftable}}
    <div class="crafting-content">
        <section>
            <h5>Skill Requirement</h5>
            <ul class="requirement-list">
                {{#each selectedCraftable.system.crafting.mainRequirements as |requirement|}}
                <li class="requirement-line"
                    data-tooltip="{{../abilityBonus}} (Ability) + {{lookup ../skills requirement.key}} (Skill) + {{../luck}} (Luck) - {{../penaltyTotal}} (Penalties) | Attempt DC {{Sum requirement.dc 10}}">
                    <span class="req-name">{{requirement.key}}</span>
                    <span class="req-value">({{Subtract (Sum (Sum ../abilityBonus (lookup ../skills requirement.key)) ../luck) ../penaltyTotal}}/{{requirement.dc}})</span>
                </li>
                {{/each}}
            </ul>
        </section>

        {{#if selectedCraftable.system.crafting.additionalRequirements}}
        <section>
            <h5>Additional Requirement</h5>
            <ul class="requirement-list">
                {{#each selectedCraftable.system.crafting.additionalRequirements as |requirement|}}
                <li class="requirement-line" data-tooltip="Attempt DC {{Sum requirement.dc 10}}">
                    <span class="req-name">{{requirement.key}}</span>
                    <span class="req-value">({{lookup ../skills requirement.key}}/{{requirement.dc}})</span>
                </li>
                {{/each}}
            </ul>
        </section>
        {{/if}}

        {{#if isArmorUpgrade}}
        <section>
            <h5>Base Item</h5>
            <select name="selectedBaseItemId" data-base-item>
                {{selectOptions baseMaterialOptions selected=selectedBaseItemId valueAttr="id" labelAttr="name"}}
            </select>
        </section>
        {{/if}}

        <section>
            <h5>Ingredients</h5>
            <ul class="requirement-list ingredients-list">
                {{!-- Craftable requirements --}}
                {{#each selectedCraftable.system.crafting.materials as |material|}}
                <li class="requirement-line">
                    <span class="req-name">{{material.name}}</span>
                    <span class="req-value">({{~#if (lookup ../materials material.uuid)~}}{{~#with (lookup ../materials material.uuid)~}}{{this.quantity}}{{~/with~}}{{~else~}}0{{~/if~}}/{{material.quantity}})</span>
                </li>
                {{/each}}

                {{!-- Craftable selected base item requirements --}}
                {{#each selectedBaseItemMaterials as |material|}}
                <li class="requirement-line">
                    <span class="req-name">{{material.name}}</span>
                    <span class="req-value">({{~#if (lookup ../materials material.uuid)~}}{{~#with (lookup ../materials material.uuid)~}}{{this.quantity}}{{~/with~}}{{~else~}}0{{~/if~}}/{{material.quantity}})</span>
                </li>
                {{/each}}
            </ul>
        </section>
    </div>
    {{else}}
    <div class="empty-state">
        <h1>Select Your Recipe</h1>
        <p>Choose an item from the category list to view crafting details.</p>
    </div>
    {{/if}}
    <footer class="crafting-footer">
        <p><a data-link="" data-uuid="Compendium.arcane-arcade-fallout.properties.Item.YK0Wfx0cfORrDzsg">Crafting Rules</a></p>
    </footer>
</section>
