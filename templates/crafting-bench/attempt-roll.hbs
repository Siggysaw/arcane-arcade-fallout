<div class="pipboy-modal">
    <header class="modal-header">
        <h2>Crafting Attempt</h2>
    </header>

    <div class="modal-body">
        <p class="modal-prompt">Attempt to craft <strong>{{ craftable.name }}</strong>?</p>

        {{#if hasSkillChoice}}
        <div class="modal-row">
            <label>Select a skill to roll against</label>
            <select name="selectedSkill" data-select-skill>
                {{selectOptions craftable.system.crafting.mainRequirements selected=selectedSkill valueAttr="key" labelAttr="key"}}
            </select>
        </div>
        {{/if}}

        <div class="dc-readout">
            <span class="dc-label">DC To Beat</span>
            <span class="dc-value">{{ dc }}</span>
        </div>
    </div>

    <div class="modal-actions flex gap-3">
        <button data-action="cancel" class="secondary">Cancel</button>
        <button data-action="roll" class="primary">Roll Dice</button>
    </div>
</div>
